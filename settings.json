{
    "chat.disableAIFeatures": true,
    "security.workspace.trust.untrustedFiles": "open",
    "security.workspace.trust.enabled": false,
    "editor.lineHeight": 1.6,
    "editor.fontFamily": "'0xProto Nerd Font','Droid Sans Mono', monospace",
    "extensions.ignoreRecommendations": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "explicit",
    "editor.cursorStyle": "line",
    "C_Cpp.inlayHints.referenceOperator.enabled": true,
    "C_Cpp.inlayHints.autoDeclarationTypes.enabled": true,
    "C_Cpp.inlayHints.parameterNames.enabled": true,
    "C_Cpp.inlayHints.autoDeclarationTypes.showOnLeft": true,
    "js/ts.inlayHints.enumMemberValues.enabled": true,
    "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
    "editor.inlayHints.padding": true,
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.detectIndentation": false,
        "editor.insertSpaces": false,
        "editor.tabSize": 3,
        "editor.formatOnSave": false,
        "editor.rulers": [
            60
        ],
    },
    "C_Cpp.clang_format_style": "{ BasedOnStyle: Google, BreakBeforeBraces: Attach, IndentWidth: 3, TabWidth: 3, ColumnLimit: 60, UseTab: Always, PointerAlignment: Left }",
}
